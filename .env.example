# Supabase (Project Settings > API). Sin estas dos variables el sitio usa los datos de ejemplo de src/data/seed.json.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dominio final, sin diagonal al final. Se usa en enlaces de WhatsApp, canonical, Open Graph y sitemap.
VITE_SITE_URL=https://inmobiliariavalle.com

# Medición. Se cargan solo si el visitante acepta el aviso de cookies.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
